# Template only. Passwords and private keys must come from a protected external source.
# This is not automatically loaded by Spring/PowerShell. Do not dot-source as PowerShell.
FOOD_DB_URL=jdbc:mysql://127.0.0.1:3306/fooddelivery?sslMode=VERIFY_IDENTITY
FOOD_DB_USERNAME=fooddelivery_app
# FOOD_DB_PASSWORD must be supplied outside Git; intentionally no default value.
# Proposed hostname only: requires approval, resolution and a trusted matching certificate.
FOOD_JWT_ISSUER=https://fooddelivery.localhost:8443
FOOD_JWT_AUDIENCE=fooddelivery-main
FOOD_JWT_PRIVATE_KEY_PATH=F:/New folder/fooddelivery-main-secrets/main-jwt-private.pem
FOOD_JWT_PUBLIC_KEY_PATH=F:/New folder/fooddelivery-main-secrets/main-jwt-public.pem
FOOD_WEB_ORIGIN=https://fooddelivery.localhost:8443
FOOD_ADMIN_BOOTSTRAP_ENABLED=false
# Build frontend separately with same-origin API; VITE values are public, never add secrets.
VITE_API_BASE_URL=/api
# VERIFY_IDENTITY also needs a trusted MySQL CA and certificate matching the DB host.
# Resolve TLS before startup. Do not silently change sslMode to DISABLED.
# External runtime yaml explicitly maps FOOD_WEB_ORIGIN to allowed-origins.
# Keep FOOD_ADMIN_BOOTSTRAP_ENABLED absent/false in the normal backend process.
